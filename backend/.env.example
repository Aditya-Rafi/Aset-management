APP_ENV=local                 # production mewajibkan JWT_SECRET dan ADMIN_PASSWORD
PORT=8090

# mysql (default) atau sqlite (tanpa setup, cocok untuk lokal)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aset_it
DB_USERNAME=root
DB_PASSWORD=
# DB_DRIVER=sqlite
# DB_SQLITE_PATH=data/app.db

JWT_SECRET=                   # >= 32 karakter; wajib di produksi (openssl rand -hex 32)
ACCESS_TOKEN_MINUTES=15       # umur token akses; penyegar berlaku 30 hari dan berputar tiap dipakai
TRUSTED_PROXIES=              # IP/CIDR proksi (mis. nginx) yang boleh dipercaya untuk X-Real-IP / X-Forwarded-For

# Surel untuk "lupa sandi" dan pemberitahuan persetujuan akun. Kosong = fitur surel mati.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                    # mis. Aset IT <noreply@domain.com>
SMTP_TLS=starttls             # starttls | tls | tidak

GUEST_ENABLED=false           # tombol "Coba sebagai tamu"; token tamu tidak bisa membaca data
GUEST_TTL_MINUTES=30

UPLOAD_DIR=uploads
FRONTEND_DIR=../frontend/dist # sajikan aplikasi Vue hasil build dari binary Go
ALLOWED_ORIGINS=http://localhost:5173

# Alamat yang ditanam di QR stiker (harus bisa dibuka dari HP). Kosong = alamat saat halaman dibuka.
PUBLIC_BASE_URL=

# Kategori bawaan masuk ke database KOSONG bila AUTO_SEED=true
AUTO_SEED=false
# Admin pertama dibuat HANYA bila tabel pengguna kosong. Tidak ada sandi bawaan.
ADMIN_USER=admin
ADMIN_PASSWORD=               # min. 12 karakter; wajib saat pertama kali jalan
ADMIN_EMAIL=                  # opsional; penerima surel pengajuan akun baru

# Formulir serah terima (PDF) mengikuti template kantor. Nama di bawah "Diketahui Oleh":
APPROVER_NAME=Siti Nurchayati
COMPANY_NAME=Departemen IT
# Kop dan tempat pada Berita Acara Serah Terima (BAST); kosong = diisi tangan
COMPANY_ADDRESS=
COMPANY_PLACE=
